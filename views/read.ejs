<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/public/stylesheets/style.css" />

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body>
    <div class="w-full h-screen bg-green-900">
      <div
        class="container mx-auto p-4 flex flex-end justify-around items-center"
      >
        <h1 class="text-3xl font-bold text-white mb-6">User Information</h1>

        <button
          class="mb-4 px-4 py-2 bg-green-500 text-white rounded-md hover:bg-green-600 cursor-pointer"
          onclick="window.history.back()"
        >
          Back
        </button>
      </div>
      <!-- {show the image and the deatil of the users } -->
        <div class="container flex gap-8 mx-auto p-4 mt-32 px-0">
            
            <!-- <div class="bg-white rounded-lg shadow-md p-6 mb-4">
            <img
                src="https://via.placeholder.com/150"
                alt="User Image"
                class="w-32 h-32 rounded-full mb-4"
            />
            <h2 class="text-xl font-bold mb-2">John Doe</h2>
            <p class="text-gray-600">john@example.com</p>
          </div>
          <div class="bg-white rounded-lg shadow-md p-6 mb-4">
            <img
                src="https://via.placeholder.com/150"
                alt="User Image"
                class="w-32 h-32 rounded-full mb-4"
            />
            <h2 class="text-xl font-bold mb-2">John Doe</h2>
            <p class="text-gray-600">john@example.com</p>
          </div> -->
            <% users.forEach((user) => { %>
                <div class="bg-white rounded-lg shadow-md p-6 mb-4">
                <img
                    src="<%= user.image %>"
                    alt="User Image"
                    class="w-32 h-32 rounded-full mb-4"
                />
                <h2 class="text-xl font-bold mb-2"><%= user.name %></h2>
                <p class="text-gray-600"><%= user.email %></p>
                </div>
            <% }) %>
        </div>
      </div>

    </div>
  </body>
</html>
